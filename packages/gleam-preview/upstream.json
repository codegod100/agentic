{
  "type": "github-release-binary",
  "github": "gleam-lang/gleam",
  "tag_prefix": "v",
  "tag_prerelease": true,
  "platforms": {
    "x86_64-linux": "gleam-v{version}-x86_64-unknown-linux-musl.tar.gz",
    "aarch64-linux": "gleam-v{version}-aarch64-unknown-linux-musl.tar.gz",
    "x86_64-darwin": "gleam-v{version}-x86_64-apple-darwin.tar.gz",
    "aarch64-darwin": "gleam-v{version}-aarch64-apple-darwin.tar.gz"
  },
  "description": "Official multi-platform prerelease tarballs (static musl on Linux). Tracks latest vX.Y.Z-rcN (etc.) GitHub prerelease."
}
